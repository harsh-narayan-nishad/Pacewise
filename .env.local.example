# Copy to .env.local and restart `npm run dev` after changing it (Next.js
# only reads NEXT_PUBLIC_* vars at build/dev-server start).
#
# URL of the standalone backend's API (see ../speed-reader-backend),
# INCLUDING its /api/v1 prefix. Leave unset/empty to run the frontend
# exactly as before — everything in lib/api/ checks for this and no-ops
# when it's missing, so the app works with or without a backend running.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
