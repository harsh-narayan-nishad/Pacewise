# Copy to `.env.production` (or set these in your host's dashboard) BEFORE `npm run build`.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
#
# Backend API base URL including its /api/v1 prefix. Leave empty to run
# the frontend on its own (everything in lib/api no-ops without it).
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
